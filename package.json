{
  "name": "openchamber-agent-timeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Swimlane timeline of the open chat in OpenChamber: one lane per agent level, one bar per thinking, tool and text segment.",
  "author": "Olivi",
  "keywords": [
    "openchamber",
    "openchamber-extension",
    "timeline",
    "swimlane",
    "observability",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oh-codes/openchamber-agent-timeline.git"
  },
  "homepage": "https://github.com/oh-codes/openchamber-agent-timeline#readme",
  "bugs": {
    "url": "https://github.com/oh-codes/openchamber-agent-timeline/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "agent-timeline",
        "name": "Agent timeline",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "page": true,
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": ["opencode"]
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node dev/serve.mjs",
    "check": "node scripts/build.mjs && git diff --exit-code -- panel && node --check service/main.js"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.7.0",
    "esbuild": "^0.25.0"
  }
}
